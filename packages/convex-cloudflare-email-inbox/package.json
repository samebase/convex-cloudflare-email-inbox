{
  "name": "@samebase/convex-cloudflare-email-inbox",
  "version": "0.4.0",
  "description": "Cloudflare email sending, inboxes, and delivery history for Convex.",
  "keywords": [
    "cloudflare",
    "convex",
    "convex-component",
    "email",
    "inbox"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samebase/convex-cloudflare-email-inbox.git",
    "directory": "packages/convex-cloudflare-email-inbox"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./convex.config.js": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.ts",
      "default": "./dist/component/_generated/component.js"
    },
    "./protocol": {
      "types": "./dist/component/mailProtocol.d.ts",
      "default": "./dist/component/mailProtocol.js"
    },
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "default": "./dist/worker/index.js"
    },
    "./r2": {
      "types": "./dist/r2.d.ts",
      "default": "./dist/r2.js"
    },
    "./receiving": {
      "types": "./dist/client/receiving.d.ts",
      "default": "./dist/client/receiving.js"
    },
    "./monitor": {
      "types": "./dist/client/monitor.d.ts",
      "default": "./dist/client/monitor.js"
    },
    "./alchemy": {
      "types": "./dist/alchemy.d.ts",
      "default": "./dist/alchemy.js"
    },
    "./test": "./src/test.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "pnpm run build",
    "build": "node ./scripts/build.ts",
    "test": "vp test",
    "codegen": "convex codegen --component-dir ./src/component"
  },
  "dependencies": {
    "cloudflare": "7.2.0",
    "convex-helpers": "0.1.127",
    "mimetext": "^3.0.28",
    "postal-mime": "^4.0.8",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "alchemy": "2.0.0-beta.83",
    "convex": "1.48.0",
    "convex-test": "0.0.65",
    "effect": "^4.0.0",
    "typescript": "~6.0.2"
  },
  "peerDependencies": {
    "alchemy": "2.0.0-beta.83",
    "convex": "^1.46.0",
    "convex-test": "^0.0.56 || ^0.0.65",
    "effect": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "alchemy": {
      "optional": true
    },
    "convex-test": {
      "optional": true
    },
    "effect": {
      "optional": true
    }
  }
}

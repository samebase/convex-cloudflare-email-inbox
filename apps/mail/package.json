{
  "name": "samebase-mail",
  "version": "0.0.0",
  "private": true,
  "description": "Cloudflare email inboxes for Convex, with a private Mail reference app.",
  "keywords": [
    "cloudflare",
    "convex",
    "email",
    "inbox"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samebase/convex-cloudflare-email-inbox.git",
    "directory": "apps/mail"
  },
  "type": "module",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.ts",
    "#hooks/*": "./src/hooks/*.ts"
  },
  "scripts": {
    "dev": "node ../../scripts/run-component-dev.ts",
    "dev:primary": "node ../../scripts/run-component-dev.ts --primary",
    "dev:frontend": "vp dev",
    "dev:worktree": "node ../../scripts/run-component-dev.ts --worktree",
    "component:build": "pnpm --filter @samebase/convex-cloudflare-email-inbox build",
    "check": "pnpm --workspace-root run check",
    "build": "node ./scripts/build-cloudflare.ts",
    "build:app": "pnpm run check && vp -C . build && node ./scripts/build-worker.ts",
    "deploy": "cf deploy --prebuilt",
    "deploy:preview": "node ./scripts/deploy-mail.ts",
    "deploy:dry-run": "pnpm run build && cf deploy --prebuilt --dry-run",
    "generate:cloudflare-redirects": "node ./scripts/generate-cloudflare-redirects.ts",
    "generate:dev-launcher-version": "node ./scripts/generate-dev-launcher-version.ts --write",
    "preview": "vp preview",
    "test": "vp test",
    "typecheck": "tsc && vp run typecheck:node && tsc --project convex/tsconfig.json && vp run typecheck:worker",
    "typecheck:node": "tsc --project tsconfig.node.json",
    "typecheck:worker": "cf workers types && tsc --project worker/tsconfig.json",
    "verify:cloudflare-redirects": "vp run generate:cloudflare-redirects && git diff --exit-code -- public/_redirects",
    "verify:dev-launcher-version": "node ./scripts/generate-dev-launcher-version.ts"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@convex-dev/auth": "^0.0.94",
    "@samebase/convex-cloudflare-email-inbox": "workspace:*",
    "@samebase/convex-cloudflare-email-inbox-ui": "workspace:*",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.45.0",
    "convex-helpers": "0.1.124",
    "lucide-react": "^1.14.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@tanstack/router-plugin": "^1.168.23",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "cf": "1.0.0-beta.12",
    "convex-test": "^0.0.56",
    "shadcn": "^4.16.1",
    "typescript": "~6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "4.136.2"
  },
  "packageManager": "pnpm@11.1.1"
}
